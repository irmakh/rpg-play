# ── RPG Play server settings ─────────────────────────────────────────────────
# Copy to Application/.env and fill in. Storage is local SQLite (one database
# per campaign) and realtime runs over WebSocket, so there are no cloud
# credentials to supply.

# Super-admin password: create/delete campaigns, the maintenance page, and the
# recovery key for a lost campaign DM password.
# REQUIRED since v226 — there is no built-in default any more. Without it the
# super-admin features are switched off.
MASTER_PASSWORD=change-me-to-a-long-secret

# ── Network ───────────────────────────────────────────────────────────────────
# Port the app listens on. Defaults: 3000 with plain HTTP, 443 when SSL is set.
# PORT=3000

# Port for the HTTP→HTTPS redirect server (only used when SSL is set). Default 80.
# HTTP_PORT=80

# ── HTTPS (production) ────────────────────────────────────────────────────────
# Set BOTH to serve HTTPS; this also turns on the HTTP→HTTPS redirect and the
# HSTS header. Leave unset for local development (plain HTTP on port 3000).
# SSL_KEY=/etc/letsencrypt/live/your-domain.com/privkey.pem
# SSL_CERT=/etc/letsencrypt/live/your-domain.com/fullchain.pem

# WebSocket URL override — only needed when browsers reach the server by a
# different host/IP than the page itself. Default: same host as the page.
# WS_URL=wss://your-domain.com/ws

# Believe the X-Forwarded-For header for the client's IP address.
# ONLY set this when a real reverse proxy sits in front of the app and
# overwrites that header. Without one, anyone could fake their address — and
# the login lockout counts failures per address. Default: off.
# TRUST_PROXY=1

# ── Storage locations (rarely changed) ────────────────────────────────────────
# Campaign registry: campaign list, DM passwords, login sessions, login audit.
# Default: Application/campaigns.db
# CAMPAIGNS_DB=/path/to/campaigns.db

# Folder holding each campaign's own databases. Default: Application/data/campaigns
# CAMPAIGN_DATA_DIR=/path/to/data/campaigns

# Not used any more: DB_PROVIDER is ignored (logged as a warning).
# AI DM provider keys (OpenRouter / OpenAI) are entered in the app's AI DM
# settings, not here.
